---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { SIDES, segments, parts, wordsOf, type Side } from '../lib/learn';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sides: Side[] = ['a', 'b'];
const examples: Record<Side, { code: string; note: string }> = {
	a: { code: 'mov ax, [speed]\nadd ax, [boost]\nmov [speed], ax', note: 'Small dictionary, long sentences: three words of work.' },
	b: { code: 'speed = speed + boost', note: 'Large dictionary, short sentences: one line.' },
};
const headline: Record<Side, { value: string; label: string }> = {
	a: { value: SIDES.a.vocab.size[0].value, label: SIDES.a.vocab.size[0].label },
	b: { value: SIDES.b.vocab.size[0].value, label: SIDES.b.vocab.size[0].label },
};
---

<StarlightPage
	frontmatter={{
		title: 'Two languages, one alphabet',
		description: 'Learn Assembly and Fortran as two real languages, with words, grammar and sentences.',
		tableOfContents: false,
		editUrl: false,
		head: [
			{ tag: 'title', content: 'Assembly and Fortran: two languages, one alphabet' },
			{ tag: 'meta', attrs: { property: 'og:title', content: 'Assembly and Fortran: two languages, one alphabet' } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{
				tag: 'meta',
				attrs: {
					property: 'og:description',
					content: 'A side: Assembly, the first language of the machine. B side: Fortran, the language that speaks maths. Learned as real languages, with a small retro game at the end.',
				},
			},
		],
	}}
>
	<div class="wide-page home">
		<p class="lead">
			You can read English. That is enough to start. This site teaches <strong>Assembly</strong>{' and '}
			<strong>Fortran</strong>{' '}as two real languages, with words, grammar and sentences. A small retro game, playable
			in this browser, is the goal at the end.
		</p>
		<p><a class="sl-link-button" href={`${base}/start-here/`}>Start here →</a></p>

		<div class="sides">
			{sides.map((s) => (
				<a class={`side-card side-${s}`} href={`${base}/${s}/`}>
					<div class="side-head"><span class="side-letter">{SIDES[s].letter}</span> {SIDES[s].label}</div>
					<div class="side-name">{SIDES[s].name}</div>
					<div class="side-tag">{SIDES[s].tagline}</div>
					<div class="side-stat"><span class="n">{headline[s].value}</span> {headline[s].label}</div>
					<div class="side-note">{examples[s].note}</div>
				</a>
			))}
		</div>
		<div class="side-examples">
			{sides.map((s) => (
				<div class={`side-${s}`}>
					<Code code={examples[s].code} lang={s === 'a' ? 'nasm' : 'fortran-free-form'} title={`${SIDES[s].label}: speed = speed + boost`} />
				</div>
			))}
		</div>

		<h2>The lens: parts of speech</h2>
		<p>
			Each language has verbs, nouns, adjectives and idioms, as English has. The numbers show how many words of each part
			are in our A-side and B-side dictionaries.
		</p>
		<div class="table-wrap">
			<table class="lens">
				<thead>
					<tr><th>Part of speech</th><th class="col-a">A side: Assembly</th><th class="col-b">B side: Fortran</th></tr>
				</thead>
				<tbody>
					{parts.map((p) => (
						<tr>
							<td><strong>{p.name}</strong><div class="muted small">{p.idea}</div></td>
							<td class="col-a">{p.a} <span class="count">{wordsOf('a').filter((w) => w.pos === p.id).length} words</span></td>
							<td class="col-b">{p.b} <span class="count">{wordsOf('b').filter((w) => w.pos === p.id).length} words</span></td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<h2>The segments</h2>
		<p>A segment is one job that a language must be able to say. Each segment has an A page and a B page.</p>
		<div class="seg-grid">
			{segments.map((sg) => (
				<div class="seg-card">
					<div class="seg-title">{sg.title}</div>
					<div class="muted small">{sg.question}</div>
					<div class="seg-links">
						<a class="pill side-a" href={`${base}/a/${sg.id}/`}>A · {wordsOf('a', sg.id).length} words</a>
						<a class="pill side-b" href={`${base}/b/${sg.id}/`}>B · {wordsOf('b', sg.id).length} words</a>
					</div>
				</div>
			))}
		</div>

		<h2>More</h2>
		<ul>
			<li><a href={`${base}/dictionary/`}>Dictionary</a>: look up each word of the two languages.</li>
			<li><a href={`${base}/compare/`}>Compare the two sides</a>: strengths and dictionary sizes in one view.</li>
			<li><a href={`${base}/plan/`}>Plan</a> and <a href={`${base}/plan/decisions/`}>decisions</a>: where the project goes next.</li>
			<li>
				<a href={`${base}/review/`}>Background research</a>: the review of four AI-written guides. It shows areas that are
				easy to miss.
			</li>
		</ul>
	</div>
</StarlightPage>
