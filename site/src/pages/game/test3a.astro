---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import game from '../../data/game.json';
import { SIDES, segmentTitle } from '../../lib/learn';
import partsData from '../../data/parts-of-speech.json';
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
type Check = { values: number; agree: number; max_error_px: number; passed: boolean };
const info = game.info as (Record<string, unknown> & { version?: string; sine_bin_bytes?: number; spin3d_com_bytes?: number; check3r?: Check }) | null;
const partName = (id: string) => partsData.find((p) => p.id === id)?.name ?? id;
const ring = Array.from({ length: 65 }, (_, k) => {
	const a = (2 * Math.PI * k) / 64;
	return `${(128 * Math.sin(a)).toFixed(1)},${(-128 * Math.cos(a)).toFixed(1)}`;
}).join(' ');
---

<StarlightPage
	frontmatter={{
		title: 'Test 3a: the wave turns',
		description: 'The sine wave goes from the back to the front, and turns around the center of the 3D space. 8086 Assembly turns each point with the sine and the cosine of the turn, and a Fortran check proves that the two sides agree.',
		tableOfContents: false,
		editUrl: false,
	}}
>
	<div class="wide-page game-page">
		<p class="lead">
			In <a href={`${base}/game/test2a/`}>test 2a</a>, the wave had depth. Here, the wave goes straight from the back to
			the front, through the center of the 3D space. Then it <strong>turns</strong> around that center, like a record on
			a turntable, and the dot moves along it. At a quarter turn, the wave goes from left to right, as in
			<a href={`${base}/game/test1/`}>test 1</a>.
		</p>

		{game.built && info?.check3r ? (
			<div class="duet" data-version={info?.version ?? ''}>
				<section class="duet-panel side-a" aria-labelledby="a-title">
					<header>
						{SIDES.a.image && <Image class="duet-photo" src={SIDES.a.image.src} alt={SIDES.a.image.alt} widths={[160, 320]} sizes="160px" />}
						<h3 id="a-title"><span class="side-letter">A</span> What the machine does</h3>
						<p class="muted small">The routines <code>spin_point</code> and <code>project</code>, for the dot on the screen now.</p>
					</header>
					<ol class="duet-steps" id="a-steps"></ol>
				</section>

				<div class="duet-screen">
					<iframe
						class="dos-screen"
						src={`${base}/game/player-spin.html?v=${info?.version ?? ''}`}
						title="A copy of a 1980s PC that runs the A-side program of test 3a"
						allow="fullscreen; autoplay"
					></iframe>
					<p class="duet-now" id="duet-now" aria-live="off">Waiting for the copy of the PC to start…</p>
					<div class="duet-controls" role="group" aria-label="Speed of the dot">
						<span class="small muted">Speed:</span>
						<button type="button" data-key="49" title="Key 1">Fastest</button>
						<button type="button" data-key="50" title="Key 2">Fast</button>
						<button type="button" data-key="51" title="Key 3">Medium</button>
						<button type="button" data-key="52" title="Key 4" aria-pressed="true">Slow</button>
						<button type="button" data-key="53" title="Key 5">Slowest</button>
						<span class="spacer"></span>
						<button type="button" data-key="32" title="Space" id="btn-pause">Pause</button>
						<button type="button" data-key="78" title="Key N">One step</button>
						<button type="button" id="btn-restart" class="ghost">Restart</button>
					</div>
					<p class="muted small">
						Magenta: the ring, the circle that the two ends of the wave follow. Gray: the wave. Cyan: its footprint on the
						floor. The wave turns one step for each two steps of the dot. A full turn has 256 steps.
					</p>
				</div>

				<section class="duet-panel side-b" aria-labelledby="b-title">
					<header>
						{SIDES.b.image && <Image class="duet-photo" src={SIDES.b.image.src} alt={SIDES.b.image.alt} widths={[160, 320]} sizes="160px" />}
						<h3 id="b-title"><span class="side-letter">B</span> The maths behind it</h3>
						<p class="muted small">The turn, seen from above, and the same point with decimal-point numbers.</p>
					</header>
					<figure class="view3d">
						<figcaption class="small muted">From above: the wave turns around the center</figcaption>
						<svg viewBox="-160 -160 320 320" role="img" aria-label="The world from above. The wave is a line through the center. It turns by the angle T.">
							<rect x="-224" y="-128" width="448" height="256" class="v-floor" />
							<polyline points={ring} class="v-ring" />
							<line x1="0" y1="-150" x2="0" y2="150" class="v-axis" />
							<line id="top-start" x1="0" y1="-128" x2="0" y2="128" class="v-start" />
							<line id="top-wave" x1="0" y1="-128" x2="0" y2="128" class="v-foot" />
							<circle id="top-dot" cx="0" cy="0" r="9" class="v-dot" />
							<circle cx="0" cy="0" r="4" class="v-eye" />
							<text x="6" y="-140" class="v-label">back</text>
							<text x="6" y="152" class="v-label">front</text>
						</svg>
					</figure>
					<ol class="duet-steps" id="b-steps"></ol>
				</section>
			</div>
		) : (
			<p class="notice">
				The game build is missing on this computer. Run <code>game/dev.sh</code>, or read the published site. GitHub
				Actions makes the build for each push.
			</p>
		)}

		<h2>What is new in test 3a</h2>
		<ol class="steps-list">
			<li>
				<span class="pill side-a">A</span> <strong>A second angle, the turn.</strong> Each point of the wave has its place
				on the wave, d = 128 − angle. Before the turn, the point is at X = 0 and Z = d: the wave goes from the back to
				the front. After a turn T, the point is at X = d · sin(T) and Z = d · cos(T). The routine is
				<code>spin_point</code> in <code>src/spin3d.inc</code>.
			</li>
			<li>
				<span class="pill side-b">B</span> <strong>The same table again.</strong> The cosine of the turn is the sine a
				quarter turn later. A full turn has 256 steps, so a quarter turn is 64 steps. Thus the A side reads the cosine
				from <code>sine.bin</code> at T + 64. <a href={`${base}/game/test3b/`}>Test 3b</a> shows what happens with a wrong
				quarter turn.
			</li>
			<li>
				<span class="pill side-a">A</span> <strong>A product that is too large for AX.</strong> d · sin(T) can be
				128 · 256 = 32768. That number does not fit in AX with a sign. <code>IMUL</code> puts the full product in DX:AX,
				and the program keeps the middle two bytes: a division by 256.
			</li>
			<li>
				<span class="pill side-a">A</span> <strong>Double buffering.</strong> In tests 1 and 2, the program drew the
				curve once. Here, the wave turns, so the whole picture changes at each step. If the program draws on the screen,
				you see the wave go away and come back. Thus the program keeps two pictures of 64000 bytes in the memory after
				the program: the background (the floor and the ring, drawn once) and the work buffer. For each step, it copies
				the background into the work buffer, draws the wave and the dot there, and copies the finished picture to the
				screen. The 8086 word <code>REP MOVSW</code> copies 32000 words with one instruction. The shared routines for
				the keys, the pixels and the screen refresh are now in <code>src/common.inc</code>.
			</li>
			<li>
				<span class="pill side-a">A</span> <span class="pill side-b">B</span> <strong>The check.</strong> The test
				(<code>test/check3r.asm</code>) runs the routines for 16 turns (0, 16, 32 … 240) and all 256 angles: 4096 points.
				The checker (<code>lab/check_spin.f90</code>) calculates them again and compares them.
			</li>
		</ol>

		{info?.check3r && (
			<div class="cards">
				<div class="card"><div class="k">The two sides agree</div><div class="v">{info.check3r.agree} / {info.check3r.values}</div><div class="s">points from the check (16 turns × 256)</div></div>
				<div class="card"><div class="k">Error from exact maths</div><div class="v">{info.check3r.max_error_px} px</div><div class="s">the cost of whole-number arithmetic</div></div>
				<div class="card"><div class="k">Size of the game</div><div class="v">{info.spin3d_com_bytes} bytes</div><div class="s">SPIN3D.COM, 8086 instructions only</div></div>
				<div class="card"><div class="k">Size of the table</div><div class="v">{info.sine_bin_bytes} bytes</div><div class="s">the same sine.bin as test 1</div></div>
			</div>
		)}

		<h2>The words that each program uses</h2>
		<p>
			The pills show the words that the <a href={`${base}/dictionary/`}>dictionary</a> already has. "New words" are real
			words of the language that the dictionary does not have yet.
		</p>
		{game.programs.filter((p) => p.test === 3).map((p) => (
			<section class={`program side-${p.side}`}>
				<h3>
					<span class="side-letter">{SIDES[p.side as 'a' | 'b'].letter}</span> <a href={p.url}><code>{p.file}</code></a>
					<span class="muted small">· {p.lines} lines · {p.role}</span>
				</h3>
				<p class="small">
					<strong>{p.matched.length} dictionary words:</strong>{' '}
					{p.matched.map((w) => (
						<a class="pill word-pill" href={`${base}/dictionary/#side=${p.side}&q=${encodeURIComponent(w.word.split(' ')[0].toLowerCase())}`} title={`${partName(w.pos)} · ${segmentTitle(w.segment)}`}>
							{w.word}
						</a>
					))}
				</p>
				{p.fresh.length > 0 && (
					<p class="small"><strong>New words ({p.fresh.length}):</strong> {p.fresh.map((w) => <code class="new-word">{w}</code>)}</p>
				)}
			</section>
		))}

		<p>
			<strong>Next:</strong> <a href={`${base}/game/test3b/`}>test 3b</a> runs this program with one wrong value, and
			shows how it breaks the game and how the check finds it.
		</p>
	</div>
</StarlightPage>

<script>
	import { followDot, wireControls, row, spinPoint, stepAngle, stepTurn, type SpinPoint } from '../../lib/spin';

	const base = document.querySelector<HTMLAnchorElement>('a.site-title')?.getAttribute('href')?.replace(/\/$/, '') ?? '';
	const frame = document.querySelector<HTMLIFrameElement>('iframe.dos-screen');
	const aSteps = document.getElementById('a-steps');
	const bSteps = document.getElementById('b-steps');
	const now = document.getElementById('duet-now');

	if (frame && aSteps && bSteps && now) {
		const version = document.querySelector<HTMLElement>('.duet')?.dataset.version ?? '';
		let steps: SpinPoint[] = [];
		fetch(`${base}/game/sine.bin?v=${version}`)
			.then((r) => r.arrayBuffer())
			.then((b) => {
				const table = new DataView(b);
				steps = Array.from({ length: 512 }, (_, s) => spinPoint(table, stepAngle(s), stepTurn(s)));
			});
		const set = (id: string, attrs: Record<string, number>) => {
			const el = document.getElementById(id);
			for (const [k, v] of Object.entries(attrs)) el?.setAttribute(k, v.toFixed(1));
		};

		function render(s: number) {
			const a = steps[s];
			const turn = (2 * Math.PI * a.t) / 256, theta = (2 * Math.PI * a.i) / 256;
			const ex = { x: a.d * Math.sin(turn), y: 64 * Math.sin(theta), z: a.d * Math.cos(turn) };
			const dist = ex.z + 448;
			const exX = 160 + (ex.x * 200) / dist, exY = 50 - ((ex.y - 120) * 200) / dist;
			const depth = a.size === 4 ? 'near' : a.size === 3 ? 'middle' : 'far';
			now!.textContent = `Turn ${a.t} of 256 · angle ${a.i} · X ${a.x}, Y ${a.y}, Z ${a.z} · screen x = ${a.sx}, y = ${a.sy}`;
			aSteps!.innerHTML = [
				row('mov ax, [sine_table + bx] · imul cx (64)', `Y = ${a.y}`, `the height: sine of angle ${a.i} = ${a.sine}`),
				row('mov cx, 128 · sub cx, si', `d = ${a.d}`, 'the place on the wave'),
				row('mov bx, bp · mov ax, [sine_table + bx]', `AX = ${a.turnSine}`, `the sine of the turn ${a.t}`),
				row('imul cx', `DX:AX = ${a.d * a.turnSine}`, ''),
				row('mov al, ah · mov ah, dl', `X = ${a.x}`, 'divide by 256'),
				row('add bx, QUARTER_TURN (64)', `step ${a.ci}`, 'a quarter turn later'),
				row('mov ax, [sine_table + bx] · imul cx', `DX:AX = ${a.d * a.turnCosine}`, `the cosine of the turn = ${a.turnCosine}`),
				row('mov al, ah · mov ah, dl', `Z = ${a.z}`, 'divide by 256'),
				row('call project', `x = ${a.sx}, y = ${a.sy}`, `the distance from the eye is ${a.distance}`),
				row('project, with Y = -96', `y = ${a.shadowY}`, 'the row of the shadow'),
				row('call plot (DL = 14)', `${a.size} × ${a.size}`, `a yellow square (${depth})`),
			].join('');
			bSteps!.innerHTML = [
				row('T = 2π · turn / 256', `${((360 * a.t) / 256).toFixed(2)}°`, 'the turn of the wave'),
				row('d = 128 − i', `${a.d}`, 'the place on the wave'),
				row('X = d · sin(T)', `${ex.x.toFixed(3)}`, `A side: ${a.x}`),
				row('Y = 64 · sin(2π · i / 256)', `${ex.y.toFixed(3)}`, `A side: ${a.y}`),
				row('Z = d · cos(T)', `${ex.z.toFixed(3)}`, `A side: ${a.z}`),
				row('x = 160 + 200 · X / (Z + 448)', `${exX.toFixed(3)}`, `A side: ${a.sx}, difference ${Math.abs(a.sx - exX).toFixed(3)} pixel`),
				row('y = 50 − 200 · (Y − 120) / (Z + 448)', `${exY.toFixed(3)}`, `A side: ${a.sy}, difference ${Math.abs(a.sy - exY).toFixed(3)} pixel`),
			].join('');
			// From above: X to the right, far (large Z) at the top.
			const ux = Math.sin(turn), uz = Math.cos(turn);
			set('top-wave', { x1: 128 * ux, y1: -128 * uz, x2: -127 * ux, y2: 127 * uz });
			set('top-dot', { cx: ex.x, cy: -ex.z });
		}

		const reset = followDot(frame, (s) => (steps.length ? steps[s].di : null), render);
		wireControls(frame, reset);
	}
</script>
