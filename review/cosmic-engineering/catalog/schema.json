{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog/schema.json",
  "title": "Cosmic engineering source catalog",
  "type": "object",
  "required": ["source_id", "source", "units"],
  "additionalProperties": false,
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source": {"type": "string", "pattern": "^sources/.+\\.md$"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["start_char", "end_char", "start_line", "end_line"],
      "additionalProperties": false,
      "properties": {
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "citation": {
      "type": "object",
      "required": ["marker", "source_range", "resolution"],
      "additionalProperties": false,
      "properties": {
        "marker": {"type": "string", "minLength": 1},
        "source_range": {"$ref": "#/$defs/range"},
        "resolution": {"enum": ["bibliography-entry-present", "url-present", "unresolved-opaque-token", "unresolved"]}
      }
    },
    "assumption": {
      "type": "object",
      "required": ["text", "basis"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "basis": {"enum": ["explicit", "inferred"]}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "proposition", "type", "source_range", "assumptions", "citation_markers", "verification", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+-c[0-9]{2,}$"},
        "proposition": {"type": "string", "minLength": 1},
        "type": {"enum": ["empirical", "quantitative", "mathematical", "software", "historical", "design-proposal", "value-judgment", "definition"]},
        "source_range": {"$ref": "#/$defs/range"},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
        "citation_markers": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "verification": {
          "type": "object",
          "required": ["priority", "methods", "evidence_needed"],
          "additionalProperties": false,
          "properties": {
            "priority": {"enum": ["high", "medium", "low"]},
            "methods": {"type": "array", "minItems": 1, "items": {"enum": ["primary-source", "independent-source", "code-inspection", "reproduction", "dimensional-analysis", "calculation", "logical-analysis", "definition-check"]}},
            "evidence_needed": {"type": "string", "minLength": 1}
          }
        },
        "status": {"const": "unchecked"},
        "target_claims": {"type": "array", "items": {"type": "string"}}
      }
    },
    "learning_goal": {
      "type": "object",
      "required": ["id", "area", "goal", "prerequisites", "claim_dependencies"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+-g[0-9]{2,}$"},
        "area": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "claim_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "title", "source_range", "purposes", "summary", "claims", "learning_goals"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-u[0-9]{2,}$"},
        "title": {"type": "string", "minLength": 1},
        "source_range": {"$ref": "#/$defs/range"},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["claim-review", "learning", "context"]}
        },
        "summary": {"type": "string", "minLength": 1},
        "context_reason": {"type": "string", "minLength": 1},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "learning_goals": {"type": "array", "items": {"$ref": "#/$defs/learning_goal"}},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
