#!/usr/bin/env bash
# Regenerate segments + the static site from the staged content and add them to this commit.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once (not recommended):  git commit --no-verify
set -euo pipefail
repo=$(git rev-parse --show-toplevel)
echo "pre-commit: regenerating segments and site (serve/)…"
if ! "$repo/site/regenerate.sh"; then
  echo "pre-commit: site regeneration FAILED; commit aborted." >&2
  exit 1
fi
