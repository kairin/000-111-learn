#!/usr/bin/env bash
# When main is pushed, publish that commit's serve/ folder to the gh-pages branch
# and push it too. GitHub Pages serves gh-pages directly; no workflow in this repo runs.
#
# gh-pages holds only the site: each deploy commit's tree IS main's serve/ tree,
# built locally by the pre-commit hook. Nothing is rebuilt here.
set -euo pipefail

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue          # branch deletion

  if ! tree=$(git rev-parse -q --verify "$local_sha:serve"); then
    echo "pre-push: commit ${local_sha:0:7} has no serve/ folder; not deploying." >&2
    exit 1
  fi

  parent=$(git rev-parse -q --verify refs/heads/gh-pages || true)
  if [ -n "$parent" ] && [ "$(git rev-parse "$parent^{tree}")" = "$tree" ]; then
    echo "pre-push: site unchanged; gh-pages already matches main@${local_sha:0:7}."
  else
    commit=$(git commit-tree "$tree" ${parent:+-p "$parent"} \
      -m "Deploy site from main@${local_sha:0:7}")
    git update-ref refs/heads/gh-pages "$commit"
    echo "pre-push: gh-pages -> $(git rev-parse --short "$commit") (site from main@${local_sha:0:7})"
  fi

  git push --no-verify --quiet "$remote" refs/heads/gh-pages:refs/heads/gh-pages </dev/null
  echo "pre-push: gh-pages pushed to $remote."
done
